# ===== Creator Publish Hub — пример конфигурации. Скопируйте в .env и заполните. =====
# Никогда не коммитьте .env в git.

# Публичный HTTPS-адрес панели (нужен для OAuth redirect и для Instagram video_url)
PUBLIC_BASE_URL=https://hub.example.com

# Каталог для базы данных и видеофайлов
DATA_DIR=./data

# Вход в панель: хэш пароля (npm run hash-password -- 'ваш-пароль')
ADMIN_PASSWORD_HASH=
# 64 hex-символа (openssl rand -hex 32) — подпись сессий и ссылок
SESSION_SECRET=
# 64 hex-символа (openssl rand -hex 32) — шифрование OAuth-токенов (AES-256-GCM). Не теряйте!
ENCRYPTION_KEY=

# Макс. размер загружаемого видео, ГБ
MAX_UPLOAD_GB=10

# ----- YouTube (Google Cloud Console → OAuth client "Web application") -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Instagram (Meta App → Instagram API with Instagram Login) -----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# ----- TikTok (developers.tiktok.com → Login Kit + Content Posting API) -----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
CLOUDFLARE_TUNNEL_TOKEN=
